# Server Settings
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false

# Security & Dashboard Login
DASHBOARD_PASSWORD=admin123
SECRET_KEY=change_this_to_a_random_secret_in_production
AGENT_API_KEY=shelf_agent_secret_key_2026

# CORS Allowed Origins (Comma-separated for deployed frontend URLs)
# Example: CORS_ORIGINS=https://smart-shelf-monitor.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Settings (MongoDB Atlas or Local MongoDB)
# For Atlas: MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
DB_NAME=shelf_monitor
MONGO_TIMEOUT_MS=2000

# YOLO Model Settings & Memory Optimization
MODEL_PATH=models/yolov8n.pt
MODEL_URL=
CONFIDENCE_THRESHOLD=0.35
INFERENCE_MAX_WIDTH=640

# Storage & File Limits
MAX_UPLOAD_MB=50
FILE_CLEANUP_HOURS=6

# Video Source Settings
# Type options: "agent" (cloud remote push), "webcam", "video", "stream" (ESP32-CAM)
# Local demo default:
DEFAULT_SOURCE_TYPE=video
DEFAULT_SOURCE_VALUE=sample_data/sample_shelf.mp4
# Cloud production default:
# DEFAULT_SOURCE_TYPE=agent
# DEFAULT_SOURCE_VALUE=remote_push

# Processing Rates
STREAM_FPS=15
PIPELINE_FPS=2.0
FRAME_SAMPLE_RATE=2.0
