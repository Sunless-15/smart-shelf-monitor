# Server Settings
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false

# Database Settings
MONGO_URI=mongodb://localhost:27017
DB_NAME=shelf_monitor
MONGO_TIMEOUT_MS=2000

# YOLO Model Settings
MODEL_PATH=models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.35

# Video Source Settings
# Type options: "webcam", "video", "stream"
# For webcam: DEFAULT_SOURCE_VALUE=0 (or 1, 2)
# For video: DEFAULT_SOURCE_VALUE=sample_data/sample_shelf.mp4
# For stream (ESP32-CAM): DEFAULT_SOURCE_VALUE=http://192.168.1.100:81/stream
DEFAULT_SOURCE_TYPE=video
DEFAULT_SOURCE_VALUE=sample_data/sample_shelf.mp4

# Processing rates
STREAM_FPS=15
PIPELINE_FPS=2.0
