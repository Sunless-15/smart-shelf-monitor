# Camera Agent Configuration
# Set BACKEND_URL to your deployed cloud URL (e.g. https://smart-shelf-backend.onrender.com)
# or local server http://127.0.0.1:5000
BACKEND_URL=http://127.0.0.1:5000

# Must match AGENT_API_KEY configured on the backend
AGENT_API_KEY=shelf_agent_secret_key_2026

# Camera identifier for multi-shelf / multi-camera setups
CAMERA_ID=shelf_camera_1

# Source type: "webcam", "video", or "stream" (ESP32-CAM)
# For local webcam:
SOURCE_TYPE=video
SOURCE_VALUE=../backend/sample_data/sample_shelf.mp4
# For ESP32-CAM:
# SOURCE_TYPE=stream
# SOURCE_VALUE=http://192.168.1.100:81/stream
# For laptop USB webcam:
# SOURCE_TYPE=webcam
# SOURCE_VALUE=0

# Ingest cadence & compression settings
INTERVAL_SECONDS=1.5
MAX_WIDTH=640
JPEG_QUALITY=70
